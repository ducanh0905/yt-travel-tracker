    {
      "id": "UgzMGSua1f8EN6Gd4rB4AaABAg",
      "author": "@GlobeRealLife360",
      "authorImage": "https://yt3.ggpht.com/jF1LvZFvxTINKSG-_3PmjcBV_lLR0dAX8m94KAhPiji4FxiX5mhj54-Pc4_W_09P3hw2nx0AeA=s48-c-k-c0x00ffffff-no-rj",
      "text": "The idea that they call a home you can't nail down 'freedom' really makes me rethink what modern 'progress' actually means.",
      "likeCount": 0,
      "publishedAt": "2026-08-18T08:27:18Z",
      "replyCount": 0,
