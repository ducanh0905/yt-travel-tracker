    {
      "id": "Ugz1lKgeM2zFPdBAxbd4AaABAg",
      "author": "@LMDiscoveryGlobe",
      "authorImage": "https://yt3.ggpht.com/8rALAIBqt0pYx97gTWOATdq9ePGhUdztROIFHredTvuTlkfotfM54-KhHOvvroumgp2UzGEMvA=s48-c-k-c0x00ffffff-no-rj",
      "text": "Having lived in Bishkek, I still think about this: we lock ourselves into 30-year mortgages while Kyrgyz nomads assemble their entire home in under an hour . Who is really free? Mind blown.",
      "likeCount": 0,
      "publishedAt": "2026-08-18T03:22:24Z",
      "replyCount": 0,
      "replies": []
    },
    {
      "id": "UgxQFgn332p2ywMmhrB4AaABAg",
      "author": "@GlobalLifeInsights",
      "authorImage": "https://yt3.ggpht.com/T3rqaKGupSF7vMt_xR3qJYWCUKNgc9c9fmGhRokt_Zf2ZadCJvl71egzuf0CjigzBww2dQvzTw=s48-c-k-c0x00ffffff-no-rj",
      "text": "Having spent time in Central Asia, I can confirm Kyrgyz hospitality is unmatched! You will literally never leave a yurt hungry.",
      "likeCount": 0,
      "publishedAt": "2026-08-18T03:02:41Z",
      "replyCount": 0,
      "replies": []
    },
    {
      "id": "UgxGWnR9ZUHfS49ckeh4AaABAg",
