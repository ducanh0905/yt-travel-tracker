    {
      "id": "UgykzG7vfhnhAFgZj394AaABAg",
      "author": "@hahahagahahshahusuahaysh1193",
      "authorImage": "https://yt3.ggpht.com/ytc/AIdro_mOOgQ2hqo_8db1L3DjyuhCoR3sEsRjEbbW34gOXd4maa9Sgm2SsTXc4jkocSqBJa1XlQ=s48-c-k-c0x00ffffff-no-rj",
      "text": "Beautiful documentary! 👏 We pay millions for apartment boxes tied to 30-year mortgages, while they carry their entire home on horseback and call the sky their ceiling. Who is actually more free? I love freedom and the feeling of being at one with nature.",
      "likeCount": 0,
      "publishedAt": "2026-08-18T08:07:26Z",
      "replyCount": 0,
      "replies": []
    },
    {
      "id": "UgwCzEGlMoCNe7PztgR4AaABAg",
      "author": "@marvinmagno1266",
      "authorImage": "https://yt3.ggpht.com/ytc/AIdro_n5kdo_NaIDIC3rlWBnjRwaV1KJZbgNW3C5hpmxtg=s48-c-k-c0x00ffffff-no-rj",
