      "authorImage": "https://yt3.ggpht.com/9JBKIYynIe9OsXVLrEA25QPWmO4I789ggz0Ik4IV9EK3L4LHMCa8om8KfPoobS5WPKEz8yH7PA=s48-c-k-c0x00ffffff-no-rj",
      "text": "Are nomadic women homeless and do they wander around?",
      "likeCount": 0,
      "publishedAt": "2026-08-18T02:44:45Z",
      "replyCount": 0,
      "replies": []
    },
    {
      "id": "Ugw2zjKqZqY-J63nzTx4AaABAg",
      "author": "@AmazingDiscoveriesTopUS",
      "authorImage": "https://yt3.ggpht.com/MBKB6SW-9Im-6wTVRC4bkBcOw4xj1onTZa79Lhxt5yKoEJTB-lNUvxCu2Ay4oPUbe8qjcoUe=s48-c-k-c0x00ffffff-no-rj",
      "text": "No wifi no running water, no power lines... yet somehow they seem happier than most of us. Could you live like this for one summer?",
      "likeCount": 1,
      "publishedAt": "2026-08-18T02:33:23Z",
      "replyCount": 0,
      "replies": []
    },
    {
      "id": "UgxMG1QzlMklFnNa-W94AaABAg",
      "author": "@Globallife.documentary",
      "authorImage": "https://yt3.ggpht.com/UT4yqZ2DrZ2fBIIQWOCcVrQYBje265v4HWuZn65ElT3j5IRtHyIw-Ezzb6kX6kLSxPFTaiT5EkE=s48-c-k-c0x00ffffff-no-rj",
      "text": "I sat in the office, scrolling through emails, while they woke up amidst that majestic mountain scenery.",
      "likeCount": 1,
      "publishedAt": "2026-08-18T02:30:57Z",
      "replyCount": 0,
      "replies": []
    },
    {
      "id": "Ugy940bUiMkoQGJH0Ch4AaABAg",
      "author": "@Reallifeinsights.26",
      "authorImage": "https://yt3.ggpht.com/mMzx8SBSXsn8xBmrmQDe86A9umm57EmFhYh6gKNDivO_sXhYsjH5m93RGwEil0fHxA86U7MrBzw=s48-c-k-c0x00ffffff-no-rj",
      "text": "No Wi-Fi, no power line, just pure mountain air and horses... Honestly, are we sure they're the ones who need rescuing, or is it us?",
